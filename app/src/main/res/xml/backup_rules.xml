<?xml version="1.0" encoding="utf-8"?>
<!-- Defense in depth for Android 8-11. Do not back up browser history,
     tabs, cookies, credentials, preferences, downloaded files or WebView data.
     android:allowBackup=false remains mandatory in the app manifest. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
